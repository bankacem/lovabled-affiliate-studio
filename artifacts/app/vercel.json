{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://krugmbovsjjgjikgzacl.supabase.co/functions/v1/sitemap" },
    { "source": "/sitemap-pages.xml", "destination": "https://krugmbovsjjgjikgzacl.supabase.co/functions/v1/sitemap?kind=pages" },
    { "source": "/sitemap-posts.xml", "destination": "https://krugmbovsjjgjikgzacl.supabase.co/functions/v1/sitemap?kind=posts" },
    { "source": "/sitemap-designs.xml", "destination": "https://krugmbovsjjgjikgzacl.supabase.co/functions/v1/sitemap?kind=designs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/((?!assets/|sitemap\\.xml).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=1800" }
      ]
    }
  ]
}
